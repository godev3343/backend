# .gitignore

# ---------- Python -----------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
.eggs/
build/
dist/
develop-eggs/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# ---------- Virtualenv / uv --------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version
# uv создаёт .venv по умолчанию; lockfile коммитим
# (uv.lock — да, не игнорируем)

# ---------- Django -----------------------------------------------------------
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
staticfiles/
/media/
mediafiles/
# миграции коммитим — НЕ игнорируем

# ---------- Env / secrets ----------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/

# ---------- Testing / coverage -----------------------------------------------
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.cache/
.hypothesis/
.tox/
.nox/
nosetests.xml
*.cover
.benchmarks/

# ---------- Type checkers / linters ------------------------------------------
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/
.pytype/

# ---------- Celery -----------------------------------------------------------
celerybeat-schedule
celerybeat-schedule.*
celerybeat.pid
*.pid

# ---------- Docker -----------------------------------------------------------
# docker-compose override — локальные тюнинги
deploy/docker-compose.override.yml
docker-compose.override.yml

# ---------- IDE / editors ----------------------------------------------------
.idea/
.vscode/
!.vscode/settings.json.example
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace

# ---------- OS ---------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# ---------- Node (на случай админ-фронта или скриптов) -----------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- Local data / dumps -----------------------------------------------
*.sql.gz
*.dump
dumps/
backups/
.tmp/
tmp/

# ---------- Sentry / monitoring artifacts -----------------------------------
.sentryclirc

# ---------- Misc -------------------------------------------------------------
*.bak
*.orig
*.rej
.netrc

CLAUDE.MD
.claude/