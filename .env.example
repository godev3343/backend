# Скопировать в .env и заполнить

# ---------- Django ----------
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=replace-me-with-32-or-more-random-characters
DEBUG=true
ALLOWED_HOSTS=["localhost","127.0.0.1"]
DJANGO_SQL_ECHO=false

# ---------- Postgres (для docker-compose) ----------
POSTGRES_DB=aireality
POSTGRES_USER=aireality
POSTGRES_PASSWORD=aireality
POSTGRES_PORT=5432

# ---------- Подключение Django к Postgres ----------
DATABASE_URL=postgres://aireality:aireality@localhost:5432/aireality

# ---------- Redis ----------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------- CORS ----------
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------- Cloudflare R2 ----------
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ---------- Media uploads ----------
UPLOAD_MAX_SIZE_AVATAR=5242880      # 5 MB
UPLOAD_MAX_SIZE_CHECKIN=20971520    # 20 MB
UPLOAD_MAX_SIZE_PLACE=20971520      # 20 MB
UPLOAD_PRESIGN_TTL=300              # 5 минут

# Минимальный размер картинки по короткой стороне (px)
MEDIA_MIN_SHORT_SIDE=400

# ---------- AI ----------
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- Google OAuth ----------
GOOGLE_OAUTH_CLIENT_ID=

# ---------- Sentry ----------
SENTRY_DSN=
ENVIRONMENT=dev

# SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-project-email@gmail.com
EMAIL_HOST_PASSWORD=abcdwxyzabcdwxyz
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL="AI Reality Map <your-project-email@gmail.com>"
DJANGO_EMAIL_REAL=false

# ---------- Frontend (для ссылок в письмах) ----------
FRONTEND_URL=http://localhost:3000

# ---------- Google OAuth ----------
GOOGLE_OAUTH_CLIENT_IDS=1234567890-abc.apps.googleusercontent.com