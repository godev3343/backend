# Скопировать в .env и заполнить
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=replace-me-with-32-or-more-random-characters
DEBUG=true
ALLOWED_HOSTS=["localhost","127.0.0.1"]

DATABASE_URL=postgres://aireality:aireality@localhost:5432/aireality
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Anthropic
ANTHROPIC_API_KEY=

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=

# Mobizon SMS
MOBIZON_API_KEY=

# Sentry
SENTRY_DSN=
ENVIRONMENT=dev